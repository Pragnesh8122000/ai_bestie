{
  "name": "ai-bestie",
  "version": "1.0.0",
  "private": true,
  "description": "AI Avatar Companion - Phase 1",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm run start -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "lint": "npm run lint -w server && npm run lint -w client",
    "lint:server": "npm run lint -w server",
    "lint:client": "npm run lint -w client",
    "test": "npm run test -w server && npm run test -w client",
    "test:server": "npm run test -w server",
    "test:client": "npm run test -w client",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
