# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-bestie

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# LLM — Gemini Flash (free tier) is the PRIMARY model.
# Get a free key at https://aistudio.google.com/apikey
# Note: gemini-2.5-flash is deprecated for new keys (404); gemini-flash-latest
# is Google's maintained alias for the current free Flash model.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-3.5-flash

# LLM — OpenRouter (OpenAI-compatible) is the SECONDARY/fallback provider.
# Used when Gemini is unavailable (no key) or all its models are rate-limited.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Default free model (free models rotate rate limits — fallbacks below are tried in order)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,meta-llama/llama-3.2-3b-instruct:free,qwen/qwen3-next-80b-a3b-instruct:free

# Optional — OpenAI Whisper API for speech-to-text (browser Web Speech API is the free default)
OPENAI_API_KEY=

# TTS — neural voice replies via sherpa-onnx (Kokoro), free + open-source, runs
# in-process (no sidecar). The ~330 MB model is downloaded once:
#   npm run download-tts-model -w server
# If the model is absent or TTS is disabled, voice replies fall back to the
# browser speechSynthesis voice automatically.
TTS_ENABLED=true
# TTS_MODEL_PATH defaults to server/.tts-models/kokoro-en-v0_19 — only set to override.
# TTS_MODEL_PATH=
# Kokoro English v0_19 speaker id: 0=af, 1=af_bella, 2=af_nicole, 3=af_sarah,
# 4=af_sky, 5=am_adam, 6=am_michael, 7=bf_emma, 8=bf_isabella, 9=bm_george, 10=bm_lewis
TTS_SID=2
TTS_MAX_CHARS=1000

# Client
CLIENT_URL=http://localhost:5173