# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-bestie

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Google Identity Services (optional). These are the same public OAuth 2.0 Web
# client ID; no client secret is used by the SPA ID-token flow.
# GOOGLE_CLIENT_ID is read by the server for audience verification.
# VITE_GOOGLE_CLIENT_ID is embedded into the client build for the GIS button.
# For local Vite development, put this value in client/.env.local as well.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# LLM — Gemini Flash (free tier) is the PRIMARY model.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# LLM — OpenRouter (OpenAI-compatible) is the SECONDARY/fallback provider.
# Used when Gemini is unavailable (no key) or all its models are rate-limited.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# OpenRouter has no catch-all free-router alias; each free model needs its
# own `:free` id. Check https://openrouter.ai/api/v1/models for the current
# free catalog if these go away.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional comma-separated account-specific fallbacks; duplicates are ignored.
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Optional paid Brave/unsupported-browser voice fallback. Browser Web Speech
# remains the free default; only failed/unsupported immersive voice turns are
# sent to OpenAI. Audio is capped at 30 seconds / 2 MiB per authenticated call.
# Deployments that set TRANSCRIPTION_MAX_DURATION_MS=12000 must raise it to
# 30000 (or remove it) when this client ships; otherwise longer fallback turns
# are rejected with 413 and the user has to repeat themselves.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_MAX_DURATION_MS=30000
TRANSCRIPTION_MAX_BYTES=2097152

# TTS — neural voice replies via sherpa-onnx (Kokoro), free + open-source, runs
# in-process (no sidecar). The ~330 MB model is downloaded once:
#   npm run download-tts-model -w server
# If the model is absent or TTS is disabled, voice replies fall back to the
# browser speechSynthesis voice automatically.
TTS_ENABLED=true
# TTS_MODEL_PATH defaults to server/.tts-models/kokoro-en-v0_19 — only set to override.
# TTS_MODEL_PATH=
# Kokoro English v0_19 speaker id: 0=af, 1=af_bella, 2=af_nicole, 3=af_sarah,
# 4=af_sky, 5=am_adam, 6=am_michael, 7=bf_emma, 8=bf_isabella, 9=bm_george, 10=bm_lewis
# Sam is female, so only the female ids (0-4, 7, 8) are accepted. A male or
# invalid id is ignored and falls back to 2 (af_nicole) — the app always speaks
# with exactly one voice.
TTS_SID=2
TTS_MAX_CHARS=1000

# Client
CLIENT_URL=http://localhost:5173
